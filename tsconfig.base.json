{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "paths": {
      "@weekly/data": ["./packages/data/src/index.ts"],
      "@weekly/domain": ["./packages/domain/src/index.ts"],
      "@weekly/sync": ["./packages/sync/src/index.ts"],
      "@weekly/ui": ["./packages/ui/src/index.ts"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
